# Required in production — a long random string.
JWT_SECRET=

# Where the SQLite file lives. Use a mounted volume in production.
DATA_DIR=data

PORT=4000

# Number of reverse proxies in front of this server. Leave at 0 when nothing is
# in front. Set to 1 behind Railway, Fly or an nginx: otherwise rate limiting
# sees every caller as the same address.
TRUST_PROXY=0

# Set this to turn on automatic backups: a consistent snapshot at boot, then
# every BACKUP_EVERY_HOURS (24 by default), keeping the last BACKUP_KEEP (7).
# Leave empty and there are no backups at all.
BACKUP_DIR=

# Notifications outside the application. Generate a pair once with
#   npm run vapid --prefix server
# Leave empty and push is simply off — nothing else changes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Set to 0 to keep the sender and the words off the lock screen.
PUSH_PREVIEW=1

# Attachments. FILES_DIR defaults to <DATA_DIR>/files, which is what you want
# when DATA_DIR is a mounted volume.
MAX_UPLOAD_BYTES=8388608
FILES_DIR=

# Opens GET /api/metrics when set. Unset, the route answers 404.
METRICS_TOKEN=

# debug | info | warn | error, and LOG_FORMAT=pretty for a terminal.
LOG_LEVEL=info
LOG_FORMAT=

# Only needed when the client is served from a different origin.
# Comma-separated, e.g. https://kairus.app,https://www.kairus.app
CORS_ORIGIN=

# Calls. Two browsers negotiate a direct path; this is what they use to find
# it. The default is a public STUN server, which covers most networks. Behind a
# symmetric NAT a relay is needed instead — set the full JSON array, e.g.
#   ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"kairus","credential":"…"}]
ICE_SERVERS=

# Contrôle des phrases secrètes contre les fuites connues (Have I Been Pwned,
# k-anonymat : seuls cinq caractères du hachage sortent). `off` pour un serveur
# sans réseau sortant ; une panne du service laisse passer de toute façon.
BREACH_CHECK=

# Required in production — a long random string.
JWT_SECRET=

# Where the SQLite file lives. Use a mounted volume in production.
DATA_DIR=data

PORT=4000

# Number of reverse proxies in front of this server. Leave at 0 when nothing is
# in front. Set to 1 behind Railway, Fly or an nginx: otherwise rate limiting
# sees every caller as the same address.
TRUST_PROXY=0

# Set this to turn on automatic backups: a consistent snapshot at boot, then
# every BACKUP_EVERY_HOURS (24 by default), keeping the last BACKUP_KEEP (7).
# Leave empty and there are no backups at all.
BACKUP_DIR=

# Only needed when the client is served from a different origin.
# Comma-separated, e.g. https://kairus.app,https://www.kairus.app
CORS_ORIGIN=
